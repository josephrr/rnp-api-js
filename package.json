{
  "name": "@egobytes/rnp-api",
  "version": "1.1.0",
  "description": "Cliente del API de consulta vehicular del Registro Nacional de Costa Rica.",
  "license": "MIT",
  "author": "Egobytes <soporte@egobytes.com>",
  "homepage": "https://rnp.egobytes.com/docs",
  "repository": {
